  "info": {
    "_postman_id": "d3b1a6d2-0f1a-4a2e-9a3a-sfrigola-core-0001",
    "name": "Sfrigola Core",
    "description": "Full API surface for sfrigola-core, organized by domain (one folder per domain). Bearer token is set once at collection level and auto-filled by the Login request — no manual header editing needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/sfrigola-core/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "publicId", "value": "", "type": "string" },
    { "key": "parentPublicId", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
